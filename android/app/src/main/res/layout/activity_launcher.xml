<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ============================ backend ============================ -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_emulator" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emulator_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/emulator_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/runtime_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rootfs_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rootfs_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/download_rootfs_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_download_rootfs" />

        <Button
            android:id="@+id/install_rootfs_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_install_rootfs" />

        <Button
            android:id="@+id/install_runtime_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_install_runtime" />

        <CheckBox
            android:id="@+id/compatibility_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/option_compatibility"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/fex_tso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/option_fex_tso"
            android:textColor="@color/text_primary" />

        <!-- ============================== game ============================= -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_game" />

        <TextView
            android:id="@+id/game_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/install_game_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_install_game" />

        <Button
            android:id="@+id/pick_game_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_pick_game" />

        <Button
            android:id="@+id/remove_game_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_remove_game"
            android:visibility="gone" />

        <!-- ========================= graphics ========================= -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_graphics" />

        <TextView
            android:id="@+id/gpu_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/turnip_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/use_turnip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/option_use_turnip"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/install_driver_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_install_driver" />

        <!-- ============================= input ============================= -->

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_input" />

        <CheckBox
            android:id="@+id/touch_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/option_touch_controls"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/haptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/option_haptics"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gamepad_note"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/edit_controls_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_edit_controls" />

        <!-- ============================== play ============================= -->

        <Button
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/action_play"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
